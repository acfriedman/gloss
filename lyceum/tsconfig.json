{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "paths": {
      "@lyceum/videos": [
        "./videos/index.ts"
      ]
    }
  },
  "include": [
    "videos"
  ],
  "exclude": [
    "node_modules",
    ".cache",
    "videos/*/dist"
  ]
}
